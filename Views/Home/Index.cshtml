@model HomeViewModel

@if (TempData["Message"] != null)
{
    <p class="display-6" style="text-align: center;">@TempData["Message"]</p>
}

@{
    ViewData["Title"] = "Service Station";
}

<div class="text-center">
    <h1 class="display-4">Service Station</h1>

    <form asp-controller="Home" asp-action="GetToken" method="post">
        @Html.AntiForgeryToken()

        <button class="btn btn-primary" type="submit">Get Token</button>
    </form>

    <form asp-controller="Home" asp-action="ServeNext" method="post">
        @Html.AntiForgeryToken()
        
        <button class="btn btn-primary" type="submit">Serve Next</button>
    </form>

    <h2 class="display-5">Now Serving</h2>

    @foreach (var token in Model.ServingTokens)
    {
        <div>
            <span class="display-6">Token: @token.TokenNumber</span>

            <form asp-controller="Home" asp-action="CompleteCurrent" method="post" style="display: inline;">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@token.Id" />
                <button class="btn btn-primary" type="submit">Complete</button>
            </form>
        </div>
    }

    <h2 class="display-5">Waiting Customers</h2>

    <!-- <p class="display-6">Waiting: @Model.WaitingTokens.Count / 5</p> -->

    @foreach (var token in Model.WaitingTokens)
    {
        <p class="display-6">Token: @token.TokenNumber</p>
    }

</div>
